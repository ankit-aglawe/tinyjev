+def anchor_loss(z, q, target, dev, temperature=1.0):
+    """KL(teacher || student) for one question, teacher = a stored distribution keyed by option key.
+    Skips (returns None) when the current option set is not exactly the teacher's (e.g. a none-option was inserted).
+    temperature > 1 softens a near-one-hot teacher (Hinton distillation): t <- softmax(log t / T); the student's
+    logits are divided by the same T so the two sides are compared on the same scale."""
     if target is None or set(target) != set(q["keys"]): return None
     t = torch.tensor([target[k] for k in q["keys"]], device=dev, dtype=torch.float32).clamp_min(1e-6); t = t / t.sum()
+    if temperature != 1.0:
